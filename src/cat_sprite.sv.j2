 *
 * Cat balloon sprite. Generated by scripts/gen_cat_sprite.py.
 *
 * Two compact bitplanes (51x26) encode a filled silhouette: at sample
 * time `hi & ~lo` selects outline (pv=1), `lo` selects fill (pv=2). A
 * sparse pv=3 accent overlay restores highlights/cheeks. The 6-state
 * cat_frame uses a 3-bit encoding so two codes stay don't-care for the
 * body sig-mask predicates.
 *
 * Owns cat_y_r and cat_frame; exports cat_rel_x/cat_rel_y so cat_speech
 * can chain its offset off the shared base. Drift is computed in
 * pixel_shader and folded into cat_rel_*.
 */

`default_nettype none

module cat_sprite (
    input  wire        clk,
    input  wire        rst_n,
    input  wire        frame_tick,
    input  wire        phase_cat_vis,
    input  wire        phase_cat_in_start,
    input  wire        phase_cat_move,     // is_cat_in | is_cat_out
    input  wire        anim_sub_tick,      // 1 once per 4 frames (ctr[1:0]==3)
    input  wire [2:0]  drift_x,            // 0..7 sprite-px x-sway (frame-stable)
    input  wire [2:0]  drift_y,            // 0..7 sprite-px y-sway (frame-stable)
    input  wire [9:0]  pixel_x,
    input  wire [9:0]  pixel_y,
    output wire [9:0]  cat_rel_x,          // pixel_x - CAT_X, for speech chain
    output wire [9:0]  cat_rel_y,          // pixel_y - cat_y_r, for speech chain
    output reg  [1:0]  r,
    output reg  [1:0]  g,
    output reg  [1:0]  b,
    output wire        visible             // gated by 104x204 bbox
);

    localparam [9:0] CY_BOT = 10'd484;
    localparam [9:0] Y_STEP = 10'd3;

    // CAT_X = 80 = 64+16 (2 set bits) — sparser than 76 makes the
    // pixel_x-CAT_X subtract cheaper; 4 px shift is imperceptible.
    localparam [9:0] CAT_X    = 10'd80;
    localparam int   CAT_PX_W = 104;    // 26 * 4
    localparam int   CAT_PX_H = 204;    // 51 * 4

    logic [9:0] cat_y_r;
    logic [2:0] cat_frame;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            cat_y_r   <= CY_BOT;
            cat_frame <= 3'd{{ reset_code }};
        end else if (frame_tick) begin
            if (phase_cat_in_start)
                cat_y_r <= CY_BOT;
            else if (phase_cat_move)
                cat_y_r <= cat_y_r - Y_STEP;

            if (phase_cat_vis & anim_sub_tick) begin
                case (cat_frame)
{{ frame_transitions }}
                    default: cat_frame <= 3'd{{ reset_code }};
                endcase
            end
        end
    end

    // bbox uses single-sided unsigned compare: underflow wraps high so
    // the same check rejects above- and below-sprite. drift_{x,y} <<2
    // upgrades sprite-pixel units to real px before subtracting.
    assign cat_rel_x = pixel_x - CAT_X   - {5'd0, drift_x, 2'd0};
    assign cat_rel_y = pixel_y - cat_y_r - {5'd0, drift_y, 2'd0};
    wire       cat_in = (cat_rel_x < 10'(CAT_PX_W)) & (cat_rel_y < 10'(CAT_PX_H));
    wire [4:0] sx     = cat_rel_x[6:2];
    wire [5:0] sy     = cat_rel_y[7:2];

    // Alias for the generated body block, which references `frame`.
    wire [2:0] frame = cat_frame;

{{ body_block }}

{{ accent_block }}

    // hi covers outline+interior; ~lo at sample splits outline (pv=1)
    // from interior (pv=2).
    wire body_lo_bit = body_lo_row[sx];
    wire body_hi_bit = body_hi_row[sx] & ~body_lo_bit;
    wire [1:0] body_pv = accent_bit ? 2'd3 : {body_hi_bit, body_lo_bit};

    wire [1:0] pv = body_pv;

    always_comb begin
        case (pv)
            2'd1: begin r = 2'd0; g = 2'd0; b = 2'd0; end
            2'd2: begin
                if (sy < 6'd19) begin
                    r = 2'd3; g = 2'd1; b = 2'd0;
                end else begin
                    r = 2'd2; g = 2'd2; b = 2'd2;
                end
            end
            2'd3: begin
                if (~sy[5]) begin
                    r = 2'd3; g = 2'd3; b = 2'd3;
                end else begin
                    r = 2'd3; g = 2'd2; b = 2'd2;
                end
            end
            default: begin r = 2'd0; g = 2'd0; b = 2'd0; end
        endcase
    end

    assign visible = cat_in & (pv != 2'd0);

endmodule
