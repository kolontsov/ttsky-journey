 *
 * Speech balloon. Generated by scripts/gen_speech.py.
 *
 * Frame is arithmetic (no ROM): rectangle with quarter-arc corners and
 * a 4-row staircase tail. Text rendered on top via inline 6x8 ATI font.
 *   sel=0 -> {{ texts_0_repr }}, sel=1 -> {{ texts_1_repr }}
 *   {{ SW }}x{{ SH }} bubble, {{ n_glyphs }} glyph inline ROM.
 */

`default_nettype none

module cat_speech (
    input  wire       sel,        // 0=LUMOS!, 1=Meow!
    input  wire [5:0] sx,         // 0..45
    input  wire [4:0] sy,         // 0..18
    output reg  [1:0] r,
    output reg  [1:0] g,
    output reg  [1:0] b,
    output wire       visible
);

{{ frame_block }}

    // Underflow on tx/ty wraps high so unsigned < doubles as in/out check.
    wire [5:0] tx = sx - 6'd{{ TEXT_SX0 }};
    wire [4:0] ty = sy - 5'd{{ TEXT_SY0 }};
    wire       in_tx = (tx < 6'd{{ TEXT_WIDTH }});
    wire       in_ty = (ty < 5'd{{ CHAR_H }});
    wire       in_text = in_tx & in_ty;
    wire [2:0] gy = ty[2:0];

{{ tx_block }}

{{ text_block }}

{{ font_block }}

    wire font_pixel = glyph_row[gx];

    // Text ink only valid inside the bubble's yellow fill region (pv==1).
    wire text_ink = in_text & font_pixel & (frame_pv == 2'd1);
    always_comb begin
        if (text_ink) begin
            r = 2'd0; g = 2'd0; b = 2'd0;
        end else begin
            case (frame_pv)
                2'd1:    begin r = 2'd3; g = 2'd3; b = 2'd0; end  // yellow
                2'd2:    begin r = 2'd0; g = 2'd0; b = 2'd0; end  // black
                default: begin r = 2'd0; g = 2'd0; b = 2'd0; end  // transparent
            endcase
        end
    end

    assign visible = (frame_pv != 2'd0);

endmodule
