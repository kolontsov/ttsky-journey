 *
 * Scroller font + text ROM. Generated by scripts/gen_scroller.py.
 *   message:   "{{ msg }}"
 *   text buf:  {{ text_len }} chars ({{ lead_in_chars }} leading spaces + msg)
 *   glyphs:    {{ n_glyphs }} unique inline ({{ font_layout }} layout, {{ rom_style }} style)
 */

`default_nettype none

module scroller_rom (
    input  wire [2:0]  text_y,
    input  wire [{{ text_x_bits_m1 }}:0] text_x,
    output wire        pixel
);

    wire [{{ char_addr_bits_m1 }}:0] char_addr = text_x[{{ text_x_bits_m1 }}:{{ within_char_bits }}];

{{ text_rom_block }}

{{ font_rom_block }}

{{ tail_block }}

endmodule
